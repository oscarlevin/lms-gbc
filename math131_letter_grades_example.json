[
  {
    "targetColumn": "Prep and Practice Total (1504450)",
    "pattern": "^(\\d+\\.\\d+ (Preview|Exercises))",
    "type": "percentage",
    "onlyRecorded": true,
    "pointsPossible": 100,
    "decimals": 2
  },
  {
    "targetColumn": "Learning Targets Mastered (1504455)",
    "pattern": "^(UD|CD|AD|ID|CC)\\s*\\d+",
    "type": "count_threshold",
    "threshold": 8,
    "pointsPossible": 23,
    "decimals": 0
  },
  {
    "targetColumn": "Written Homework Total (1504451)",
    "pattern": "^Homework\\s*\\d+",
    "type": "average",
    "onlyRecorded": true,
    "dropLowest": 1,
    "pointsPossible": 100,
    "decimals": 2
  },
  {
    "targetColumn": "Final Letter Grade",
    "type": "letter_grade",
    "defaultGrade": "F",
    "treatMissingAsZero": false,
    "grades": [
      {
        "grade": "A",
        "when": {
          "all": [
            { "column": "Learning Targets Mastered", "op": ">=", "value": 22 },
            { "column": "Prep and Practice Total", "op": ">=", "value": 90 },
            { "column": "Written Homework Total", "op": ">=", "value": 90 }
          ]
        }
      },
      {
        "grade": "B",
        "when": {
          "any": [
            {
              "all": [
                { "column": "Learning Targets Mastered", "op": ">=", "value": 19 },
                { "column": "Prep and Practice Total", "op": ">=", "value": 80 },
                { "column": "Written Homework Total", "op": ">=", "value": 80 }
              ]
            },
            {
              "all": [
                { "column": "Learning Targets Mastered", "op": ">=", "value": 22 },
                { "column": "Prep and Practice Total", "op": ">=", "value": 70 }
              ]
            }
          ]
        }
      },
      {
        "grade": "C",
        "when": {
          "all": [
            { "column": "Learning Targets Mastered", "op": "between", "value": [16, 18] },
            { "column": "Prep and Practice Total", "op": ">=", "value": 70 }
          ]
        }
      },
      {
        "grade": "D",
        "when": {
          "all": [
            { "column": "Learning Targets Mastered", "op": ">=", "value": 12 }
          ]
        }
      }
    ]
  }
]
